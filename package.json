{
  "name": "zestora",
  "version": "0.1.0",
  "private": true,
  "description": "Zestora beverage ordering and business management platform",
  "engines": {
    "node": "^24.12.0",
    "npm": ">=11"
  },
  "workspaces": [
    "apps/web",
    "apps/api"
  ],
  "scripts": {
    "dev": "concurrently --kill-others --names web,api \"npm:dev:web\" \"npm:dev:api\"",
    "demo:shop": "node scripts/shop-test-server.mts --demo",
    "dev:web": "npm run dev --workspace @zestora/web",
    "dev:api": "npm run dev --workspace @zestora/api",
    "typecheck": "npm run typecheck --workspaces",
    "build": "npm run build --workspaces",
    "start:api": "npm run start --workspace @zestora/api",
    "preview:web": "npm run preview --workspace @zestora/web",
    "test:web": "npm run test:e2e --workspace @zestora/web",
    "test:api": "npm run test --workspace @zestora/api",
    "seed:demo": "node --env-file-if-exists=.env scripts/seed-demo.mts",
    "create:admin": "node --env-file-if-exists=.env scripts/create-admin.mts",
    "test:production": "node scripts/production-smoke.mts",
    "test:shop": "npm run test:shop --workspace @zestora/web"
  },
  "devDependencies": {
    "concurrently": "^10.0.7"
  }
}
