# Optional Vite proxy setting. Copy to apps/web/.env.local if the API address changes.
API_PROXY_TARGET=http://127.0.0.1:3001

# Use api to load published products from Express and MongoDB.
VITE_CATALOGUE_MODE=demo

# Optional public storefront information. VITE_ settings are included in the web build.
VITE_BUSINESS_EMAIL=
VITE_BUSINESS_PHONE=
VITE_BUSINESS_ADDRESS=
VITE_BUSINESS_HOURS_EN=
VITE_BUSINESS_HOURS_SI=
VITE_BUSINESS_MAP_URL=
VITE_BUSINESS_WHATSAPP_URL=
VITE_BUSINESS_INSTAGRAM_URL=
VITE_BUSINESS_FACEBOOK_URL=
