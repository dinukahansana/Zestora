# Optional API settings. Copy to .env to change the local defaults.
HOST=127.0.0.1
PORT=3001

# Database configuration. Put real values in the ignored .env only.
MONGODB_URI=
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:4173
TRUST_PROXY_HOPS=0

# Public site origin and optional SMTP mail delivery for password resets.
SITE_ORIGIN=http://127.0.0.1:5173
SMTP_URL=
MAIL_FROM=

# Optional server-side image storage. Supply the Cloudinary URL in .env only.
CLOUDINARY_URL=

# PayHere needs a merchant account and an approved public HTTPS callback.
PAYHERE_MODE=sandbox
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=
PAYHERE_NOTIFY_URL=
PAYHERE_LIVE_ENABLED=false
# The local simulator is available only outside production.
PAYHERE_SIMULATOR=false

# Optional n8n production webhook base. Keep the signing secret server-side.
N8N_WEBHOOK_BASE_URL=
N8N_SHARED_SECRET=
# Independent key used by the n8n scheduled report Header Auth credential.
N8N_SCHEDULE_KEY=

# Optional OpenAI-compatible AI API. Use the provider's base API URL and model name.
AI_API_BASE_URL=
AI_API_KEY=
AI_MODEL=

# Supply these only for the explicit npm run create:admin command.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
