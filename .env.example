# Optional API settings. Copy to .env to change the local defaults.
HOST=127.0.0.1
PORT=3001

# Database configuration. Put real values in the ignored .env only.
MONGODB_URI=
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:4173
TRUST_PROXY_HOPS=0

# Public site origin and optional SMTP mail delivery for password resets.
SITE_ORIGIN=http://127.0.0.1:5173
SMTP_URL=
MAIL_FROM=

# Optional server-side image storage. Supply the Cloudinary URL in .env only.
CLOUDINARY_URL=

# Supply these only for the explicit npm run create:admin command.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
